# Site
NEXT_PUBLIC_SITE_URL=https://jmcanboyjewelry.com
PREVIEW_TOKEN=change-me-to-a-long-random-string
ADMIN_EMAIL=you@example.com

# Appwrite (Cloud or self-hosted)
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=your-project-id
APPWRITE_API_KEY=your-api-key
APPWRITE_DATABASE_ID=jmcanboy
APPWRITE_BUCKET_MOLD_PHOTOS=mold-photos
# Private dentist scans (.stl/.obj/.ply). Free Cloud often allows only one bucket —
# if creating `scans` fails, set this to your mold-photos bucket ID and add those extensions.
APPWRITE_BUCKET_SCANS=scans

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Resend
RESEND_API_KEY=re_...
EMAIL_FROM=JMCANBOY Jewelry <orders@jmcanboyjewelry.com>

# Optional
CRON_SECRET=change-me
# METALS_API_URL=
# METALS_API_KEY=
# METALS_API_SOURCE=
